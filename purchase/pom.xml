<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lukawska</groupId>
        <artifactId>trainSmart</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>purchase</artifactId>

    <properties>
        <openapi.baseName>purchase</openapi.baseName>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lukawska</groupId>
            <artifactId>mailing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lukawska</groupId>
            <artifactId>training-plan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lukawska</groupId>
            <artifactId>file-export</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-openapi-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/${openapi.baseName}api.yml</inputSpec>
                            <typeMappings>
                                <typeMapping>DateTime=Instant</typeMapping>
                                <typeMapping>decimal=BigDecimal</typeMapping>
                            </typeMappings>
                            <importMappings>
                                <importMapping>Instant=java.time.Instant</importMapping>
                                <importMapping>BigDecimal=java.math.BigDecimal</importMapping>
                            </importMappings>
                            <configOptions>
                                <generateBuilders>true</generateBuilders>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
